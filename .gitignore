# Planning documents — working notes, not shipped artifacts.
docs/plan/

# Airtight working state.
#
# Tracked on purpose: config.json, controls.json, findings.ndjson, and
# engagements/. A gitignored findings store would lose the status lifecycle on
# every clone, so a fixed-then-reintroduced vulnerability would read as new
# rather than as a regression.
.airtight/config.local.json
.airtight/hook.cache.json
.airtight/*.log
.airtight/audit.ndjson

# Dependencies and build output.
node_modules/
dist/

# OS and editor noise.
.DS_Store
*.swp

# Compiled rule bundle — regenerated by `npm run build:rules`.
engine/build/

# Credential-shaped fixtures and demo files, materialized by
# scripts/gen-secrets.mjs. Not committed: a literal in a provider's format is
# indistinguishable from a live credential to a secret scanner, and asking
# people to allowlist secrets in order to clone a security tool is a poor
# first impression. The reviewable form is fixtures/secrets.spec.mjs and the
# templates in demo/templates/.
fixtures/flag/dep/npm-auth-token-committed/
fixtures/pass/dep/npm-auth-token-committed/
