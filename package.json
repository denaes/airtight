{
  "name": "airtight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Security fluency for AI coding agents. One skill, deterministic rule packs, and an edit hook.",
  "homepage": "https://github.com/denaes/airtight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denaes/airtight.git"
  },
  "bugs": {
    "url": "https://github.com/denaes/airtight/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build:rules": "node scripts/compile-rules.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "build": "npm run gen:secrets && npm run build:rules && npm run build:engine && npm run build:docs && node scripts/build.js",
    "build:release": "npm run gen:secrets && npm run build:rules && npm run build:engine && npm run build:docs && node scripts/build.js --sync",
    "test": "node --test tests/*.test.mjs",
    "detect": "node engine/src/cli.mjs detect",
    "pack:dry": "npm pack --dry-run",
    "build:docs": "node scripts/build-docs.mjs",
    "demo": "node scripts/demo.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "pretest": "npm run gen:secrets && npm run build:rules"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "yaml": "^2.6.0"
  },
  "author": {
    "name": "Airtight contributors"
  },
  "bin": {
    "airtight": "cli/bin/airtight.js"
  },
  "files": [
    "cli/",
    "skill/",
    "scripts/lib/",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "security",
    "appsec",
    "secrets",
    "sast",
    "supply-chain",
    "iac",
    "terraform",
    "kubernetes",
    "claude",
    "skill",
    "agent"
  ]
}
